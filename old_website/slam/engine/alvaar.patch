+int System::getMapPoints(int pointsPtr, int maxPoints)
+{
+    if (!mapManager_ || maxPoints <= 0)
+    {
+        return 0;
+    }
+
+    auto *data = reinterpret_cast<float *>(pointsPtr);
+    int count = 0;
+
+    for (const auto &[id, mapPoint] : mapManager_->mapMapPoints_)
+    {
+        (void) id;
+        if (!mapPoint || !mapPoint->is3d_ || mapPoint->isBad() || count >= maxPoints)
+        {
+            continue;
+        }
+
+        const Eigen::Vector3d point = mapPoint->getPoint();
+        const cv::Scalar color = mapPoint->color_;
+        data[count * 6 + 0] = static_cast<float>(point.x());
+        data[count * 6 + 1] = static_cast<float>(point.y());
+        data[count * 6 + 2] = static_cast<float>(point.z());
+        data[count * 6 + 3] = static_cast<float>(color[2]);
+        data[count * 6 + 4] = static_cast<float>(color[1]);
+        data[count * 6 + 5] = static_cast<float>(color[0]);
+        ++count;
+    }
+
+    return count;
+}
