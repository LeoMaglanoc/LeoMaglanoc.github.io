{
    "name": "party-panic",
    "version": "0.1.0",
    "private": true,
    "description": "Host-authoritative browser party race with solo practice",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "check": "npm run typecheck && npm run lint && npm test && npm run build"
    },
    "dependencies": {
        "peerjs": "1.5.5",
        "playcanvas": "2.23.3",
        "qrcode": "1.5.4"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.64.1",
        "@types/qrcode": "1.5.6",
        "eslint": "9.39.5",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
